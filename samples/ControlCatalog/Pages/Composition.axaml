<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Composition visual graph" FontSize="19" FontWeight="SemiBold"/>
<TextBlock Text="Keyframes and expressions execute on the selected rendering topology. Implicit mode changes destination properties only; reusable animation groups handle motion and retargeting." TextWrapping="Wrap"/>
<Border Background="#15182B" CornerRadius="14" Padding="18"><Control Name="CompositionHost" Height="240" ClipToBounds="True"/></Border>
<StackPanel Orientation="Horizontal" Spacing="12"><Button Name="AnimateComposition" Content="Start animation"/><Button Name="StopComposition" Content="Stop animation"/></StackPanel>
<StackPanel Orientation="Horizontal" Spacing="12"><Button Name="MoveImplicitComposition" Content="Move implicitly / retarget"/><Button Name="ClearImplicitComposition" Content="Clear implicit animations"/></StackPanel>
<TextBlock Name="CompositionStatus"/>
</StackPanel></Border>
</StackPanel>
