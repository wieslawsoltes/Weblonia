<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Layout-aware transforms" FontSize="17" FontWeight="SemiBold"/><LayoutTransformControl LayoutTransform="rotate(-12)" HorizontalAlignment="Center"><Border Background="{DynamicResource SystemSelectionBrush}" Padding="36"><TextBlock Text="Rotated during layout" FontSize="24"/></Border></LayoutTransformControl></StackPanel></Border>
</StackPanel>
