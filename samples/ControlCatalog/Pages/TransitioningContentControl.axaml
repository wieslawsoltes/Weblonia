<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Animated replacement" FontSize="17" FontWeight="SemiBold"/><Button Content="Change content" Click="ChangeContent" HorizontalAlignment="Left"/><TransitioningContentControl x:Name="TransitionHost" Height="190"/></StackPanel></Border>
</StackPanel>
