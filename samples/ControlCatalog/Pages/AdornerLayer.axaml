<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Overlay visuals" FontSize="17" FontWeight="SemiBold"/><Grid Height="200"><TextBox Text="An overlay can decorate an existing control." Width="430" VerticalAlignment="Center"/><Canvas IsHitTestVisible="False"><Border Canvas.Left="0" Canvas.Top="30" Background="#6757D9" CornerRadius="4" Padding="9"><TextBlock Text="Retained visual overlay" Foreground="White"/></Border></Canvas></Grid></StackPanel></Border>
</StackPanel>
