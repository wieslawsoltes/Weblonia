<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Button variants" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="PrimaryButton" Classes="accent" Content="Primary action" Command="{Binding IncrementCommand}"/><Button Content="Standard" Command="{Binding IncrementCommand}"/><Button Content="Disabled" IsEnabled="False"/><ToggleButton Content="Toggle"/></StackPanel></StackPanel></Border><Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Reactive command" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CounterText" Text="{Binding Counter,StringFormat='Executed {0} times'}" FontSize="28"/><StackPanel Orientation="Horizontal" Spacing="12"><RepeatButton Content="Press and hold" Command="{Binding IncrementCommand}"/><Button Content="Reset" Command="{Binding ResetCommand}"/></StackPanel></StackPanel></Border>
</StackPanel>
