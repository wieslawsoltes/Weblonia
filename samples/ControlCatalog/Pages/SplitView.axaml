<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Collapsible pane" FontSize="17" FontWeight="SemiBold"/><Button Content="Toggle pane" Click="TogglePane" HorizontalAlignment="Left"/><SplitView x:Name="Split" Height="260"/></StackPanel></Border>
</StackPanel>
