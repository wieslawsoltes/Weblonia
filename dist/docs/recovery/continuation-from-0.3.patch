te option\" IsThreeState=\"True\"/><CheckBox Content=\"Disabled option\" IsEnabled=\"False\" IsChecked=\"True\"/><TextBlock Text=\"{Binding Checked,StringFormat='Model: {0}'}\"/></StackPanel></Border>\n</StackPanel>\n","Clipboard":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"System clipboard\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox x:Name=\"ClipboardText\" Text=\"AvaloniaWeb uses the browser clipboard API.\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Copy\" Click=\"Copy\"/><Button Content=\"Paste\" Click=\"Paste\"/></StackPanel><TextBlock x:Name=\"ClipboardStatus\" Text=\"Clipboard access depends on browser permissions and a secure origin.\" TextWrapping=\"Wrap\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","ColorPicker":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Color selection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><ColorPicker x:Name=\"Picker\" Width=\"180\" Height=\"40\"/><ColorView x:Name=\"Colors\" Width=\"320\" Height=\"234\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","ComboBox":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Selection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><ComboBox x:Name=\"Combo\" ItemsSource=\"{Binding Languages}\" SelectedIndex=\"1\" Width=\"320\" HorizontalAlignment=\"Left\"/><TextBlock x:Name=\"ChoiceText\" Text=\"Select a language, or use the arrow keys.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","CommandBar":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Commands\" FontSize=\"17\" FontWeight=\"SemiBold\"/><CommandBar x:Name=\"MenuHost\" Height=\"42\"/><TextBlock x:Name=\"MenuStatus\" Text=\"Open File or Edit.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","Composition":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Composition visual graph\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"A keyframe animation and a parsed expression run over committed scene properties. This browser compositor executes on the UI thread.\" TextWrapping=\"Wrap\"/>\n<Border Background=\"#15182B\" CornerRadius=\"14\" Padding=\"18\"><Control Name=\"CompositionHost\" Height=\"240\" ClipToBounds=\"True\"/></Border>\n<StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Name=\"AnimateComposition\" Content=\"Start animation\"/><Button Name=\"StopComposition\" Content=\"Stop animation\"/></StackPanel>\n<TextBlock Name=\"CompositionStatus\"/>\n</StackPanel></Border>\n</StackPanel>\n","ContainerQueries":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\">\n<TextBlock Text=\"Ancestor-size queries\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"Resize the container. Its descendant styles activate above 380 device-independent pixels, then withdraw below the threshold.\" TextWrapping=\"Wrap\"/>\n<Slider Name=\"ContainerWidth\" Minimum=\"220\" Maximum=\"680\" Value=\"460\"/>\n<Border Name=\"QueryHost\" Width=\"460\" HorizontalAlignment=\"Left\" Padding=\"22\" CornerRadius=\"12\" Background=\"#EEEAFB\" Container.Name=\"DemoHost\" Container.Sizing=\"Width\">\n<Border.Styles><Style Selector=\"TextBlock.responsive\"><Setter Property=\"FontSize\" Value=\"18\"/><Setter Property=\"Foreground\" Value=\"#5A526F\"/></Style><ContainerQuery Name=\"DemoHost\" Query=\"min-width: 380\"><Style Selector=\"TextBlock.responsive\"><Setter Property=\"FontSize\" Value=\"34\"/><Setter Property=\"Foreground\" Value=\"#5B43BB\"/></Style></ContainerQuery></Border.Styles>\n<TextBlock Name=\"ResponsiveText\" Classes=\"responsive\" Text=\"One control. Responsive styles.\" TextWrapping=\"Wrap\"/>\n</Border><TextBlock Name=\"QueryStatus\"/>\n</StackPanel></Border>\n</StackPanel>\n","ContentPage":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Content page\" FontSize=\"17\" FontWeight=\"SemiBold\"/><ContentPage><Border Background=\"{DynamicResource SystemSelectionBrush}\" Padding=\"40\" CornerRadius=\"8\"><StackPanel Spacing=\"12\"><TextBlock Text=\"A page is a content host.\" FontSize=\"24\"/><TextBlock Text=\"Page content participates in the same visual and logical trees.\" TextWrapping=\"Wrap\"/></StackPanel></Border></ContentPage></StackPanel></Border>\n</StackPanel>\n","ContextFlyout":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Retained popup surface\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Button x:Name=\"FlyoutTarget\" Content=\"Open flyout\" Click=\"OpenFlyout\" HorizontalAlignment=\"Left\"/><TextBlock Text=\"The popup is rendered into the same native Skia surface.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","ContextMenu":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Retained popup surface\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Button x:Name=\"FlyoutTarget\" Content=\"Open context menu\" Click=\"OpenFlyout\" HorizontalAlignment=\"Left\"/><TextBlock Text=\"The popup is rendered into the same native Skia surface.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","Cursor":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Pointer cursors\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Crosshair\" Cursor=\"crosshair\"/><Button Content=\"Move\" Cursor=\"move\"/><Button Content=\"Text\" Cursor=\"text\"/><Button Content=\"Help\" Cursor=\"help\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","CustomDrawing":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Drawing primitives\" FontSize=\"17\" FontWeight=\"SemiBold\"/><ContentControl x:Name=\"DrawingHost\" Height=\"350\"/></StackPanel></Border>\n</StackPanel>\n","DataValidation":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Binding validation\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox x:Name=\"Validated\" Text=\"{Binding Name,Mode=TwoWay}\"/><TextBlock x:Name=\"ValidationText\" Foreground=\"#C24858\"/><TextBlock Text=\"The binding keeps the model unchanged when validation rejects an edit.\" Classes=\"muted\" TextWrapping=\"Wrap\"/></StackPanel></Border>\n</StackPanel>\n","DateTimePicker":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBloc