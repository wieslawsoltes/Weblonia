ui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n  <Border Classes=\"card\">\n    <StackPanel Spacing=\"12\">\n      <TextBlock Text=\"Pinch and rotate\" FontSize=\"17\" FontWeight=\"SemiBold\"/>\n      <TextBlock Text=\"Use two touch contacts to scale and rotate. One contact scrolls the list below; dragging does not activate its buttons.\" TextWrapping=\"Wrap\"/>\n      <Border x:Name=\"PointerArea\" ClipToBounds=\"True\" Background=\"{DynamicResource SystemSelectionBrush}\" Height=\"210\" CornerRadius=\"8\">\n        <Border.GestureRecognizers><PinchGestureRecognizer/></Border.GestureRecognizers>\n        <Border x:Name=\"GestureVisual\" Width=\"190\" Height=\"90\" Background=\"#6757d9\" CornerRadius=\"10\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\">\n          <TextBlock Text=\"Pinch · Rotate\" Foreground=\"White\" FontSize=\"22\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/>\n        </Border>\n      </Border>\n      <TextBlock x:Name=\"PointerText\" Text=\"Two-contact input: ready\" TextWrapping=\"Wrap\"/>\n    </StackPanel>\n  </Border>\n  <Border Classes=\"card\">\n    <StackPanel Spacing=\"12\">\n      <TextBlock Text=\"Touch scrolling with inertia\" FontSize=\"17\" FontWeight=\"SemiBold\"/>\n      <ScrollViewer x:Name=\"GestureScroll\" Height=\"210\"><StackPanel x:Name=\"GestureItems\" Spacing=\"8\"/></ScrollViewer>\n      <TextBlock x:Name=\"GestureStatus\" Text=\"Taps: 0 · scroll offset: 0\"/>\n    </StackPanel>\n  </Border>\n</StackPanel>\n","HeaderedContentControl":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Header and content\" FontSize=\"17\" FontWeight=\"SemiBold\"/><HeaderedContentControl Header=\"Connection settings\"><TextBox Text=\"https://localhost:4173\"/></HeaderedContentControl></StackPanel></Border>\n</StackPanel>\n","Image":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Bitmap decoding\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Image x:Name=\"BitmapImage\" Height=\"280\" Stretch=\"Uniform\"/><TextBlock Text=\"The image is generated locally, decoded and drawn by SkiaSharpWeb.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","Label":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Captions and targets\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Label Content=\"_Display name\" Target=\"{x:Reference NameInput}\"/><TextBox x:Name=\"NameInput\" Text=\"{Binding Name,Mode=TwoWay}\" Width=\"360\" HorizontalAlignment=\"Left\"/></StackPanel></Border>\n</StackPanel>\n","LayoutTransformControl":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Layout-aware transforms\" FontSize=\"17\" FontWeight=\"SemiBold\"/><LayoutTransformControl LayoutTransform=\"rotate(-12)\" HorizontalAlignment=\"Center\"><Border Background=\"{DynamicResource SystemSelectionBrush}\" Padding=\"36\"><TextBlock Text=\"Rotated during layout\" FontSize=\"24\"/></Border></LayoutTransformControl></StackPanel></Border>\n</StackPanel>\n","ListBox":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Virtualized collection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Grid ColumnDefinitions=\"*,240\" ColumnSpacing=\"24\"><ListBox x:Name=\"VirtualList\" ItemsSource=\"{Binding LargeItems}\" Height=\"390\"/><StackPanel Grid.Column=\"1\" Spacing=\"12\"><TextBlock Text=\"10,000 items\" FontSize=\"26\"/><TextBlock Text=\"Fixed-height virtualization with overscan. Scroll, use arrow keys, or jump to the end.\" TextWrapping=\"Wrap\" Classes=\"muted\"/><Button Content=\"Jump to item 9,999\" Click=\"JumpToEnd\"/><TextBlock x:Name=\"ListSelection\" Text=\"Select a row\" TextWrapping=\"Wrap\"/></StackPanel></Grid></StackPanel></Border>\n</StackPanel>\n","Menu":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Commands\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Menu x:Name=\"MenuHost\" Height=\"42\"/><TextBlock x:Name=\"MenuStatus\" Text=\"Open File or Edit.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","NativeEmbed":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Native HTML control hosting\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"A real browser input is hosted inside the retained layout. Its handle is an HTMLElement; no desktop child-window handle is fabricated.\" TextWrapping=\"Wrap\"/>\n<Border Name=\"NativeSlot\" Height=\"130\" ClipToBounds=\"True\" CornerRadius=\"12\"/>\n<TextBlock Name=\"NativePreview\" Text=\"{Binding Name, StringFormat='Reactive model: {0}'}\" FontSize=\"18\"/>\n<TextBox Name=\"NativeModelEditor\" Text=\"{Binding Name, Mode=TwoWay}\"/>\n<TextBlock Text=\"Both editors share the same ReactiveWeb property. The native layer is clipped to its retained ancestors, and is disposed when navigating away.\" TextWrapping=\"Wrap\"/>\n</StackPanel></Border>\n</StackPanel>\n","NavigationPage":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\