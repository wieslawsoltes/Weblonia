+    const a = m[0] * m[0] + m[3] * m[3], b = m[1] * m[1] + m[4] * m[4], c = m[0] * m[1] + m[3] * m[4];
+    const scale = Math.sqrt(Math.max(0, (a + b + Math.sqrt((a - b) ** 2 + 4 * c * c)) / 2));
+    return { ScaleX: finite(scale, fallbackScale) || fallbackScale, ScaleY: finite(scale, fallbackScale) || fallbackScale, PhaseX: 0, PhaseY: 0, AxisAligned: false };
+}
+export function CreateTextRasterPlan(metrics, size, geometry, tileSize = 2048) {
+    const { ScaleX: sx, ScaleY: sy, PhaseX: px = 0, PhaseY: py = 0 } = geometry;
+    if (!(Number.isFinite(sx) && sx > 0 && Number.isFinite(sy) && sy > 0)) throw new RangeError('Text raster scales must be positive and finite.');
+    if (!Number.isInteger(tileSize) || tileSize < 16 || tileSize > 8192) throw new RangeError('Text tile size must be an integer from 16 to 8192.');
+    // Font ink can extend both left of the origin and beyond its advance width.
+    const left = Math.floor(-finite(metrics.Left, 0) * sx + px) - 2;
+    const right = Math.ceil(finite(metrics.Right, metrics.Width) * sx + px) + 2;
+    const top = Math.floor(-finite(metrics.Ascent, size * .8) * sy + py) - 2;
+    const bottom = Math.ceil(finite(metrics.Descent, size * .2) * sy + py) + 2;
+    if (![left, right, top, bottom].every(Number.isSafeInteger)) throw new RangeError('Text raster bounds exceed safe integer precision.');
