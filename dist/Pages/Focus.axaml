<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Focus navigation" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBox x:Name="FocusOne" Text="First" Width="150"/><TextBox x:Name="FocusTwo" Text="Second" Width="150"/><Button Content="Focus first" Click="FocusFirst"/></StackPanel><TextBlock x:Name="FocusStatus" Text="Use Tab and Shift+Tab to move focus."/></StackPanel></Border>
</StackPanel>
