<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Absolute layout" FontSize="17" FontWeight="SemiBold"/><Canvas Height="260" Background="{DynamicResource SystemSurfaceAltBrush}"><Rectangle Canvas.Left="30" Canvas.Top="35" Width="180" Height="110" Fill="#6757D9" RadiusX="14"/><Ellipse Canvas.Left="150" Canvas.Top="100" Width="150" Height="150" Fill="#329E93"/><TextBlock Canvas.Left="330" Canvas.Top="65" Text="Canvas.Left = 330" FontSize="20"/></Canvas></StackPanel></Border>
</StackPanel>
