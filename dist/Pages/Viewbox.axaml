<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Scale to fit" FontSize="17" FontWeight="SemiBold"/><Viewbox Width="600" Height="230" Stretch="Uniform"><Border Width="300" Height="100" Background="#6757D9" CornerRadius="12"><TextBlock Text="One visual. Any size." Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Viewbox></StackPanel></Border>
</StackPanel>
