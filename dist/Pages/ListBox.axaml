<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Virtualized collection" FontSize="17" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,240" ColumnSpacing="24"><ListBox x:Name="VirtualList" ItemsSource="{Binding LargeItems}" Height="390"/><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="10,000 items" FontSize="26"/><TextBlock Text="Fixed-height virtualization with overscan. Scroll, use arrow keys, or jump to the end." TextWrapping="Wrap" Classes="muted"/><Button Content="Jump to item 9,999" Click="JumpToEnd"/><TextBlock x:Name="ListSelection" Text="Select a row" TextWrapping="Wrap"/></StackPanel></Grid></StackPanel></Border>
</StackPanel>
