<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Relative constraints" FontSize="17" FontWeight="SemiBold"/><RelativePanel Height="240"><Border x:Name="Anchor" Width="180" Height="70" Background="#6757D9" CornerRadius="8"><TextBlock Text="Anchor" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border RelativePanel.RightOf="Anchor" Width="180" Height="70" Margin="12,0,0,0" Background="#329E93" CornerRadius="8"><TextBlock Text="RightOf Anchor" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button RelativePanel.Below="Anchor" Content="Below Anchor" Margin="0,12,0,0"/></RelativePanel></StackPanel></Border>
</StackPanel>
