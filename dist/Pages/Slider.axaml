<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Two-way range binding" FontSize="17" FontWeight="SemiBold"/><Slider x:Name="Range" Minimum="0" Maximum="100" Value="{Binding Value,Mode=TwoWay}"/><ProgressBar x:Name="Progress" Value="{Binding Value}" Height="8"/><StackPanel Orientation="Horizontal" Spacing="12"><NumericUpDown Minimum="0" Maximum="100" Value="{Binding Value,Mode=TwoWay}" Width="160"/><TextBlock Text="{Binding Value,StringFormat='Value: {0:N0}'}" VerticalAlignment="Center"/></StackPanel></StackPanel></Border><Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Discrete ticks" FontSize="17" FontWeight="SemiBold"/><Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="4"/></StackPanel></Border>
</StackPanel>
