<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Isolated WebGL context leases" FontSize="19" FontWeight="SemiBold"/>
<TextBlock Text="A context lease saves and restores the documented framebuffer, viewport, program, vertex array and selected render states." TextWrapping="Wrap"/>
<Border Name="GlSlot" Height="310" ClipToBounds="True" CornerRadius="12" Background="#15182B"/>
<StackPanel Orientation="Horizontal" Spacing="12"><Button Name="GlRedraw" Content="Rotate and render"/><Button Name="GlLease" Content="Validate lease restoration"/></StackPanel>
<TextBlock Name="GlStatus" Text="Initializing WebGL2…" TextWrapping="Wrap"/>
</StackPanel></Border>
</StackPanel>
