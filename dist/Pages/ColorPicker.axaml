<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Color selection" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><ColorPicker x:Name="Picker" Width="180" Height="40"/><ColorView x:Name="Colors" Width="320" Height="234"/></StackPanel></StackPanel></Border>
</StackPanel>
