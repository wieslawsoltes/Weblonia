<StackPanel xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Spacing="18">
<Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="Keyboard command" FontSize="17" FontWeight="SemiBold"/><Button x:Name="AcceleratorTarget" Content="Press Ctrl+K here" Command="{Binding IncrementCommand}"/><TextBlock Text="{Binding Counter,StringFormat='Command count: {0}'}"/></StackPanel></Border>
</StackPanel>
