 Spacing=\"12\"><NumericUpDown Minimum=\"0\" Maximum=\"100\" Value=\"{Binding Value,Mode=TwoWay}\" Width=\"160\"/><TextBlock Text=\"{Binding Value,StringFormat='Value: {0:N0}'}\" VerticalAlignment=\"Center\"/></StackPanel></StackPanel></Border><Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Discrete ticks\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Slider Minimum=\"0\" Maximum=\"10\" TickFrequency=\"1\" IsSnapToTickEnabled=\"True\" Value=\"4\"/></StackPanel></Border>\n</StackPanel>\n","SplitView":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Collapsible pane\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Button Content=\"Toggle pane\" Click=\"TogglePane\" HorizontalAlignment=\"Left\"/><SplitView x:Name=\"Split\" Height=\"260\"/></StackPanel></Border>\n</StackPanel>\n","TabControl":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Tabbed selection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TabControl x:Name=\"Tabs\" Height=\"260\"/></StackPanel></Border>\n</StackPanel>\n","TabStrip":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Tabbed selection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TabStrip x:Name=\"Tabs\" Height=\"260\"/></StackPanel></Border>\n</StackPanel>\n","TabbedPage":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Tabbed selection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TabbedPage x:Name=\"Tabs\" Height=\"260\"/></StackPanel></Border>\n</StackPanel>\n","TableView":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Component inventory\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TableView x:Name=\"Table\" ItemsSource=\"{Binding Rows}\" Height=\"370\"/></StackPanel></Border>\n</StackPanel>\n","TextBlock":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Typography\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBlock Text=\"A familiar API. A new platform.\" FontSize=\"30\" FontWeight=\"SemiBold\"/><TextBlock Text=\"AvaloniaWeb separates layout, styling, binding and rendering. Text uses browser font metrics and glyph rasters, composed by native Skia.\" TextWrapping=\"Wrap\" FontSize=\"16\"/><TextBlock Text=\"Underlined text\" TextDecorations=\"Underline\"/><TextBlock Text=\"Obsolete content\" TextDecorations=\"Strikethrough\"/><SelectableTextBlock Text=\"This paragraph is selectable. Drag the pointer across the text, then copy it.\" TextWrapping=\"Wrap\"/></StackPanel></Border>\n</StackPanel>\n","TextBox":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Live model binding\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox x:Name=\"NameEditor\" Text=\"{Binding Name,Mode=TwoWay}\" PlaceholderText=\"Your name\"/><TextBlock x:Name=\"NamePreview\" Text=\"{Binding Name,StringFormat='Hello, {0}'}\" FontSize=\"22\"/></StackPanel></Border><Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Editing surfaces\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox Text=\"Multiple lines.&#10;Selection, clipboard, undo and IME are handled by the browser.\" AcceptsReturn=\"True\" TextWrapping=\"Wrap\" Height=\"110\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><TextBox Text=\"secret-password\" PasswordChar=\"●\" Width=\"250\"/><TextBox Text=\"Read-only content\" IsReadOnly=\"True\" Width=\"250\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","ThemeVariants":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Light and dark resources\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Light theme\" Click=\"LightTheme\"/><Button Content=\"Dark theme\" Click=\"DarkTheme\"/></StackPanel><Border Background=\"{DynamicResource SystemSelectionBrush}\" Padding=\"24\" CornerRadius=\"8\"><TextBlock Text=\"This brush is a DynamicResource.\" FontSize=\"21\"/></Border></StackPanel></Border>\n</StackPanel>\n","ToggleSwitch":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Settings\" FontSize=\"17\" FontWeight=\"SemiBold\"/><ToggleSwitch Content=\"Enable notifications\" IsChecked=\"{Binding Checked,Mode=TwoWay}\"/><ToggleSwitch Content=\"Sync across windows\" IsChecked=\"True\"/><ToggleSwitch Content=\"Unavailable setting\" IsEnabled=\"False\"/></StackPanel></Border>\n</StackPanel>\n","ToolTip":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Hover hints\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Hover for a hint\" ToolTip.Tip=\"This hint is drawn with native Skia.\"/><Button Content=\"A second hint\" ToolTip.Tip=\"Try keyboard focus and the source editor too.\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","TransitioningContentControl":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Animated replacement\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Button Content=\"Change content\" Click=\"ChangeContent\" HorizontalAlignment=\"Left\"/><TransitioningContentControl x:Name=\"TransitionHost\" Height=\"190\"/></StackPanel></Border>\n</StackPanel>\n","TreeView":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Project explorer\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TreeView x:Name=\"Tree\" Height=\"380\"/></StackPanel></Border>\n</StackPanel>\n","Viewbox":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Scale to fit\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Viewbox Width=\"600\" Height=\"230\" Stretch=\"Uniform\"><Border Width=\"300\" Height=\"100\" Background=\"#6757D9\" CornerRadius=\"12\"><TextBlock Text=\"One visual. Any size.\" Foreground=\"White\" FontSize=\"23\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/></Border></Viewbox></StackPanel></Border>\n</StackPanel>\n","WindowCustomizations":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Browser-owned windows\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBlock Text=\"Window.Show opens a real browser window. Desktop minimize, taskbar identity and arbitrary native decorations are not available through standard browser APIs.\" TextWrapping=\"Wrap\" Classes=\"muted\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Open browser window\" Click=\"NewWindow\"/><Button Content=\"Fullscreen\" Click=\"Fullscreen\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","WrapPanel":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Flow layout\" FontSize=\"17\" FontWeight=\"SemiBold\"/><WrapPanel x:Name=\"Wrap\" ItemWidth=\"155\" ItemHeight=\"54\"/></StackPanel></Border>\n</StackPanel>\n"};
+export const Sources = {"MainView":"<Grid xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n      x:Name=\"Shell\" RowDefinitions=\"72,*,32\" Background=\"{DynamicResource SystemBackgroundBrush}\">\n  <Grid.Styles>\n    <Style Selector=\"Button.nav\"><Setter Property=\"HorizontalContentAlignment\" Value=\"Left\"/><Setter Property=\"BorderThickness\" Value=\"0\"/><Setter Property=\"Background\" Value=\"Transparent\"/><Setter Property=\"CornerRadius\" Value=\"6\"/></Style>\n    <Style Selector=\"Button.nav.selected\"><Setter Property=\"Background\" Value=\"{DynamicResource SystemSelectionBrush}\"/><Setter Property=\"Foreground\" Value=\"{DynamicResource SystemAccentBrush}\"/></Style>\n  </Grid.Styles>\n  <Border Background=\"{DynamicResource SystemSurfaceBrush}\" BorderBrush=\"{DynamicResource SystemBorderBrush}\" BorderThickness=\"0,0,0,1\" Padding=\"26,16\">\n    <Grid ColumnDefinitions=\"Auto,*,Auto\" ColumnSpacing=\"18\">\n      <Border Width=\"36\" Height=\"36\" Background=\"#6757D9\" CornerRadius=\"10\"><TextBlock Text=\"A\" Foreground=\"White\" FontSize=\"25\" FontWeight=\"Bold\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/></Border>\n      <StackPanel Grid.Column=\"1\" Orientation=\"Horizontal\" Spacing=\"14\" VerticalAlignment=\"Center\"><TextBlock Text=\"Avalonia\" FontSize=\"22\" FontWeight=\"SemiBold\"/><TextBlock Text=\"/\" Foreground=\"{DynamicResource SystemMutedBrush}\" FontSize=\"22\"/><TextBlock Text=\"Control Catalog\" FontSize=\"16\" VerticalAlignment=\"Center\"/></StackPanel>\n      <StackPanel Grid.Column=\"2\" Orientation=\"Horizontal\" Spacing=\"10\"><Button x:Name=\"ThemeButton\" Content=\"◐  Theme\" Click=\"ToggleTheme\"/><Button x:Name=\"WindowButton\" Content=\"↗  New window\" Click=\"NewWindow\"/><Border Background=\"{DynamicResource SystemSelectionBrush}\" CornerRadius=\"4\" Padding=\"9,5\" VerticalAlignment=\"Center\"><TextBlock Text=\"WEB · ALPHA\" FontSize=\"10\" FontWeight=\"Bold\" Foreground=\"{DynamicResource SystemAccentBrush}\"/></Border></StackPanel>\n    </Grid>\n  </Border>\n  <Grid Grid.Row=\"1\" x:Name=\"Workspace\" ColumnDefinitions=\"258,*\">\n    <Border Background=\"{DynamicResource SystemSurfaceAltBrush}\" BorderBrush=\"{DynamicResource SystemBorderBrush}\" BorderThickness=\"0,0,1,0\" Padding=\"16,20,12,12\">\n      <Grid RowDefinitions=\"Auto,Auto,*\" RowSpacing=\"14\">\n        <TextBox x:Name=\"SearchBox\" Text=\"{Binding Query,Mode=TwoWay}\" PlaceholderText=\"Search controls…\" Height=\"38\"/>\n        <Button x:Name=\"HomeButton\" Grid.Row=\"1\" Content=\"⌂   Overview\" Classes=\"nav\" Click=\"Home\"/>\n        <ScrollViewer x:Name=\"NavigationScroll\" Grid.Row=\"2\" HorizontalScrollBarVisibility=\"Disabled\"><StackPanel x:Name=\"NavigationItems\" Spacing=\"3\"/></ScrollViewer>\n      </Grid>\n    </Border>\n    <Grid Grid.Column=\"1\" RowDefinitions=\"Auto,*,Auto\" Margin=\"34,26,34,20\" RowSpacing=\"20\">\n      <StackPanel Spacing=\"8\">\n        <TextBlock Text=\"{Binding Breadcrumb}\" Classes=\"muted\" FontSize=\"12\"/>\n        <Grid ColumnDefinitions=\"*,Auto\" ColumnSpacing=\"20\">\n          <TextBlock x:Name=\"PageTitle\" Text=\"{Binding CurrentTitle}\" FontSize=\"32\" FontWeight=\"SemiBold\"/>\n          <Button Grid.Column=\"1\" x:Name=\"SourceButton\" Content=\"&lt;/&gt;  XAML source\" Click=\"ToggleSource\" VerticalAlignment=\"Center\"/>\n        </Grid>\n        <TextBlock Text=\"{Binding Description}\" Classes=\"muted\" TextWrapping=\"Wrap\" FontSize=\"14\"/>\n      </StackPanel>\n      <ScrollViewer x:Name=\"PageScroll\" Grid.Row=\"1\" HorizontalScrollBarVisibility=\"Disabled\"><ContentControl x:Name=\"PageHost\" HorizontalContentAlignment=\"Stretch\"/></ScrollViewer>\n      <Border x:Name=\"SourcePane\" Grid.Row=\"2\" IsVisible=\"False\" Classes=\"card\" Padding=\"12\">\n        <Grid RowDefinitions=\"Auto,*\" Height=\"250\" RowSpacing=\"10\">\n          <Grid ColumnDefinitions=\"*,Auto\" ColumnSpacing=\"10\"><TextBlock Text=\"XAML → AST → JavaScript emitter\" FontWeight=\"SemiBold\" VerticalAlignment=\"Center\"/><Button Grid.Column=\"1\" x:Name=\"ApplyXamlButton\" Content=\"Compile &amp; apply\" Classes=\"accent\" Click=\"ApplyXaml\"/></Grid>\n          <TextBox x:Name=\"SourceEditor\" Grid.Row=\"1\" AcceptsReturn=\"True\" AcceptsTab=\"True\" TextWrapping=\"NoWrap\" FontFamily=\"monospace\" FontSize=\"12\"/>\n        </Grid>\n      </Border>\n    </Grid>\n  </Grid>\n  <Border Grid.Row=\"2\" BorderBrush=\"{DynamicResource SystemBorderBrush}\" BorderThickness=\"0,1,0,0\" Background=\"{DynamicResource SystemSurfaceBrush}\" Padding=\"22,6\">\n    <Grid ColumnDefinitions=\"*,Auto\"><TextBlock x:Name=\"StatusText\" Text=\"{Binding Status}\" FontSize=\"11\" Classes=\"muted\"/><TextBlock Grid.Column=\"1\" Text=\"{Binding RendererStatus}\" FontSize=\"11\" Foreground=\"{DynamicResource SystemAccentBrush}\"/></Grid>\n  </Border>\n</Grid>\n","Accelerator":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Keyboard command\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Button x:Name=\"AcceleratorTarget\" Content=\"Press Ctrl+K here\" Command=\"{Binding IncrementCommand}\"/><TextBlock Text=\"{Binding Counter,StringFormat='Command count: {0}'}\"/></StackPanel></Border>\n</StackPanel>\n","Acrylic":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Native Skia backdrop sampling\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"Acrylic blurs the pixels already drawn in this canvas. It does not sample the desktop outside the browser.\" TextWrapping=\"Wrap\"/>\n<Border Name=\"AcrylicSlot\" Height=\"300\" ClipToBounds=\"True\" CornerRadius=\"14\"/>\n<TextBlock Text=\"Tint opacity\"/><Slider Name=\"AcrylicTint\" Minimum=\"0\" Maximum=\"1\" Value=\"0.35\"/>\n<TextBlock Text=\"Blur radius\"/><Slider Name=\"AcrylicBlur\" Minimum=\"0\" Maximum=\"35\" Value=\"18\"/>\n</StackPanel></Border>\n</StackPanel>\n","AdornerLayer":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Overlay visuals\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Grid Height=\"200\"><TextBox Text=\"An overlay can decorate an existing control.\" Width=\"430\" VerticalAlignment=\"Center\"/><Canvas IsHitTestVisible=\"False\"><Border Canvas.Left=\"0\" Canvas.Top=\"30\" Background=\"#6757D9\" CornerRadius=\"4\" Padding=\"9\"><TextBlock Text=\"Retained visual overlay\" Foreground=\"White\"/></Border></Canvas></Grid></StackPanel></Border>\n</StackPanel>\n","AutoCompleteBox":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Language suggestions\" FontSize=\"17\" FontWeight=\"SemiBold\"/><AutoCompleteBox x:Name=\"AutoComplete\" ItemsSource=\"{Binding Languages}\" PlaceholderText=\"Start typing a language…\" Width=\"380\" HorizontalAlignment=\"Left\"/><TextBlock Text=\"Suggestions are retained ListBox containers in a popup.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","BitmapCache":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Visual snapshots and invalidation\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"Both panels draw the same geometry. Redrawing the host reuses the cached panel. Mutating its content invalidates the snapshot.\" TextWrapping=\"Wrap\"/>\n<Grid Name=\"CacheSlot\" ColumnDefinitions=\"*,*\" ColumnSpacing=\"18\" Height=\"250\"/>\n<StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Name=\"RedrawCache\" Content=\"Redraw host\"/><Button Name=\"InvalidateCache\" Content=\"Change geometry\"/></StackPanel>\n<TextBlock Name=\"CacheStatus\"/>\n</StackPanel></Border>\n</StackPanel>\n","Border":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Borders and corners\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Border Background=\"#EEEAFB\" BorderBrush=\"#6757D9\" BorderThickness=\"2\" CornerRadius=\"16\" Padding=\"28\"><TextBlock Text=\"Rounded\" Foreground=\"#4C3BAF\"/></Border><Border Background=\"#E6F4EE\" BorderBrush=\"#29986B\" BorderThickness=\"2,6,2,2\" Padding=\"28\"><TextBlock Text=\"Per-side border\" Foreground=\"#176646\"/></Border></StackPanel></StackPanel></Border>\n</StackPanel>\n","ButtonSpinner":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Increment and decrement\" FontSize=\"17\" FontWeight=\"SemiBold\"/><ButtonSpinner x:Name=\"Spinner\" Width=\"300\" HorizontalAlignment=\"Left\" Content=\"{Binding Counter}\"/><TextBlock Text=\"Use the arrow buttons to change the counter.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","Buttons":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Button variants\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button x:Name=\"PrimaryButton\" Classes=\"accent\" Content=\"Primary action\" Command=\"{Binding IncrementCommand}\"/><Button Content=\"Standard\" Command=\"{Binding IncrementCommand}\"/><Button Content=\"Disabled\" IsEnabled=\"False\"/><ToggleButton Content=\"Toggle\"/></StackPanel></StackPanel></Border><Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Reactive command\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBlock x:Name=\"CounterText\" Text=\"{Binding Counter,StringFormat='Executed {0} times'}\" FontSize=\"28\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><RepeatButton Content=\"Press and hold\" Command=\"{Binding IncrementCommand}\"/><Button Content=\"Reset\" Command=\"{Binding ResetCommand}\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","Calendar":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Pick a date\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Calendar x:Name=\"Calendar\" Width=\"310\" Height=\"310\"/><StackPanel Spacing=\"10\" Width=\"220\"><TextBlock Text=\"Keyboard navigation\" FontSize=\"17\"/><TextBlock Text=\"Arrow keys change the selected day. Page Up and Page Down change the month.\" TextWrapping=\"Wrap\" Classes=\"muted\"/><TextBlock x:Name=\"DateText\" Text=\"No date selected\" TextWrapping=\"Wrap\"/></StackPanel></StackPanel></StackPanel></Border>\n</StackPanel>\n","CalendarDatePicker":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Popup calendar\" FontSize=\"17\" FontWeight=\"SemiBold\"/><CalendarDatePicker x:Name=\"DatePicker\" Width=\"320\" HorizontalAlignment=\"Left\"/><TextBlock x:Name=\"DateText\" Text=\"Open the date selector.\"/></StackPanel></Border>\n</StackPanel>\n","Canvas":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Absolute layout\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Canvas Height=\"260\" Background=\"{DynamicResource SystemSurfaceAltBrush}\"><Rectangle Canvas.Left=\"30\" Canvas.Top=\"35\" Width=\"180\" Height=\"110\" Fill=\"#6757D9\" RadiusX=\"14\"/><Ellipse Canvas.Left=\"150\" Canvas.Top=\"100\" Width=\"150\" Height=\"150\" Fill=\"#329E93\"/><TextBlock Canvas.Left=\"330\" Canvas.Top=\"65\" Text=\"Canvas.Left = 330\" FontSize=\"20\"/></Canvas></StackPanel></Border>\n</StackPanel>\n","Carousel":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Slide through content\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Carousel x:Name=\"Carousel\" Height=\"220\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"← Previous\" Click=\"Previous\"/><Button Content=\"Next →\" Click=\"Next\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","CarouselPage":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Slide through content\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Carousel x:Name=\"Carousel\" Height=\"220\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"← Previous\" Click=\"Previous\"/><Button Content=\"Next →\" Click=\"Next\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","CheckBox":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Check states\" FontSize=\"17\" FontWeight=\"SemiBold\"/><CheckBox x:Name=\"Check\" Content=\"Two-way checked state\" IsChecked=\"{Binding Checked,Mode=TwoWay}\"/><CheckBox Content=\"Three-state option\" IsThreeState=\"True\"/><CheckBox Content=\"Disabled option\" IsEnabled=\"False\" IsChecked=\"True\"/><TextBlock Text=\"{Binding Checked,StringFormat='Model: {0}'}\"/></StackPanel></Border>\n</StackPanel>\n","Clipboard":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"System clipboard\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox x:Name=\"ClipboardText\" Text=\"AvaloniaWeb uses the browser clipboard API.\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Copy\" Click=\"Copy\"/><Button Content=\"Paste\" Click=\"Paste\"/></StackPanel><TextBlock x:Name=\"ClipboardStatus\" Text=\"Clipboard access depends on browser permissions and a secure origin.\" TextWrapping=\"Wrap\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","ColorPicker":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Color selection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><ColorPicker x:Name=\"Picker\" Width=\"180\" Height=\"40\"/><ColorView x:Name=\"Colors\" Width=\"320\" Height=\"234\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","ComboBox":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Selection\" FontSize=\"17\" FontWeight=\"SemiBold\"/><ComboBox x:Name=\"Combo\" ItemsSource=\"{Binding Languages}\" SelectedIndex=\"1\" Width=\"320\" HorizontalAlignment=\"Left\"/><TextBlock x:Name=\"ChoiceText\" Text=\"Select a language, or use the arrow keys.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","CommandBar":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Commands\" FontSize=\"17\" FontWeight=\"SemiBold\"/><CommandBar x:Name=\"MenuHost\" Height=\"42\"/><TextBlock x:Name=\"MenuStatus\" Text=\"Open File or Edit.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","Composition":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Composition visual graph\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"A keyframe animation and a parsed expression run over committed scene properties. This browser compositor executes on the UI thread.\" TextWrapping=\"Wrap\"/>\n<Border Background=\"#15182B\" CornerRadius=\"14\" Padding=\"18\"><Control Name=\"CompositionHost\" Height=\"240\" ClipToBounds=\"True\"/></Border>\n<StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Name=\"AnimateComposition\" Content=\"Start animation\"/><Button Name=\"StopComposition\" Content=\"Stop animation\"/></StackPanel>\n<TextBlock Name=\"CompositionStatus\"/>\n</StackPanel></Border>\n</StackPanel>\n","ContainerQueries":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\">\n<TextBlock Text=\"Ancestor-size queries\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"Resize the container. Its descendant styles activate above 380 device-independent pixels, then withdraw below the threshold.\" TextWrapping=\"Wrap\"/>\n<Slider Name=\"ContainerWidth\" Minimum=\"220\" Maximum=\"680\" Value=\"460\"/>\n<Border Name=\"QueryHost\" Width=\"460\" HorizontalAlignment=\"Left\" Padding=\"22\" CornerRadius=\"12\" Background=\"#EEEAFB\" Container.Name=\"DemoHost\" Container.Sizing=\"Width\">\n<Border.St