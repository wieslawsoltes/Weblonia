ckPanel>\n","PipsPager":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Page indicators\" FontSize=\"17\" FontWeight=\"SemiBold\"/><PipsPager x:Name=\"Pips\" NumberOfPages=\"7\" SelectedPageIndex=\"2\"/><TextBlock x:Name=\"PipsText\" Text=\"Click a dot or use the arrow keys.\"/></StackPanel></Border>\n</StackPanel>\n","PlatformInformation":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Browser platform\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox x:Name=\"PlatformDetails\" IsReadOnly=\"True\" AcceptsReturn=\"True\" TextWrapping=\"Wrap\" Height=\"320\" FontFamily=\"monospace\" FontSize=\"13\"/></StackPanel></Border>\n</StackPanel>\n","PlatformSettings":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Browser platform\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox x:Name=\"PlatformDetails\" IsReadOnly=\"True\" AcceptsReturn=\"True\" TextWrapping=\"Wrap\" Height=\"320\" FontFamily=\"monospace\" FontSize=\"13\"/></StackPanel></Border>\n</StackPanel>\n","Pointers":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Pointer input\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Border x:Name=\"PointerArea\" Background=\"{DynamicResource SystemSelectionBrush}\" Height=\"280\" CornerRadius=\"8\"><TextBlock x:Name=\"PointerText\" Text=\"Move, press or touch this surface.\" TextWrapping=\"Wrap\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/></Border></StackPanel></Border>\n