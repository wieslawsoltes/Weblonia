ce\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Button x:Name=\"FlyoutTarget\" Content=\"Open context menu\" Click=\"OpenFlyout\" HorizontalAlignment=\"Left\"/><TextBlock Text=\"The popup is rendered into the same native Skia surface.\" Classes=\"muted\"/></StackPanel></Border>\n</StackPanel>\n","Cursor":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Pointer cursors\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Crosshair\" Cursor=\"crosshair\"/><Button Content=\"Move\" Cursor=\"move\"/><Button Content=\"Text\" Cursor=\"text\"/><Button Content=\"Help\" Cursor=\"help\"/></StackPanel></StackPanel></Border>\n</StackPanel>\n","CustomDrawing":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Drawing primitives\" FontSize=\"17\" FontWeight=\"SemiBold\"/><ContentControl x:Name=\"DrawingHost\" Height=\"350\"/></StackPanel></Border>\n</StackPanel>\n","DataValidation":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Binding validation\" FontSize=\"17\" FontWeight=\"SemiBold\"/><TextBox x:Name=\"Validated\" Text=\"{Binding Name,Mode=TwoWay}\"/><TextBlock x:Name=\"ValidationText\" Foreground=\"#C24858\"/><TextBlock Text=\"The binding keeps the model unchanged when validation rejects an edit.\" Classes=\"muted\" TextWrapping=\"Wrap\"/></StackPanel></Border>\n</StackPanel>\n","DateTimePicker":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBloc