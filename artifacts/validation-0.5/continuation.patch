"Navigation stack\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Content=\"Push page\" Click=\"PushPage\"/><Button Content=\"← Back\" Click=\"PopPage\"/></StackPanel><NavigationPage x:Name=\"Navigator\" Height=\"230\"/></StackPanel></Border>\n</StackPanel>\n","Notifications":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Non-modal notifications\" FontSize=\"17\" FontWeight=\"SemiBold\"/><Button Content=\"Show notification\" Click=\"Notify\" Classes=\"accent\" HorizontalAlignment=\"Left\"/></StackPanel></Border>\n</StackPanel>\n","NumericUpDown":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"Numeric values\" FontSize=\"17\" FontWeight=\"SemiBold\"/><StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><NumericUpDown x:Name=\"Numeric\" Minimum=\"0\" Maximum=\"100\" Increment=\"1\" Value=\"{Binding Value,Mode=TwoWay}\" Width=\"220\"/><NumericUpDown Minimum=\"-50\" Maximum=\"50\" Increment=\"0.25\" Value=\"3.5\" Width=\"220\"/></StackPanel><ProgressBar Value=\"{Binding Value}\" Height=\"8\"/></StackPanel></Border>\n</StackPanel>\n","OpenGL":"<StackPanel xmlns=\"https://github.com/avaloniaui\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\" Spacing=\"18\">\n<Border Classes=\"card\"><StackPanel Spacing=\"16\"><TextBlock Text=\"WebGL2 rendering lifecycle\" FontSize=\"19\" FontWeight=\"SemiBold\"/>\n<TextBlock Text=\"A WebGL2 control renders a real shader, then transfers RGBA pixels to a native Skia image.\" TextWrapping=\"Wrap\"/>\n<Border Name=\"GlSlot\" Height=\"310\" ClipToBounds=\"True\" CornerRadius=\"12\" Background=\"#15182B\"/>\n<StackPanel Orientation=\"Horizontal\" Spacing=\"12\"><Button Name=\"GlRedraw